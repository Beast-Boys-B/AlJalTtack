{
  "manifest_version": 3,
  "name": "알잘딱 - AI 프롬프트 도우미",
  "description": "자연어를 카테고리별 규칙으로 정제해 Claude/ChatGPT/Gemini/Grok에 바로 보내는 프롬프트 도우미",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/claude.ts-loader-CdEgak5S.js"
      ],
      "matches": [
        "https://claude.ai/*"
      ]
    },
    {
      "js": [
        "assets/chatgpt.ts-loader-DGTDB3-7.js"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ]
    },
    {
      "js": [
        "assets/gemini.ts-loader-DIDT0tq3.js"
      ],
      "matches": [
        "https://gemini.google.com/*"
      ]
    },
    {
      "js": [
        "assets/grok.ts-loader-DFAXaZbK.js"
      ],
      "matches": [
        "https://grok.x.ai/*",
        "https://grok.com/*"
      ]
    }
  ],
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://grok.x.ai/*",
    "https://grok.com/*"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "resources": [
        "assets/insertText-UBc8MZCn.js",
        "assets/claude.ts-5DpvaoJ6.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "resources": [
        "assets/insertText-UBc8MZCn.js",
        "assets/chatgpt.ts-CEmtw0U9.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "resources": [
        "assets/insertText-UBc8MZCn.js",
        "assets/gemini.ts-B3girVBw.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://grok.com/*",
        "https://grok.x.ai/*"
      ],
      "resources": [
        "assets/insertText-UBc8MZCn.js",
        "assets/grok.ts-D1TB79tG.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
